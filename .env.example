# === Kalo — variables de entorno ===
# Copia este fichero a `.env` y rellena los valores reales.
# `.env` NUNCA se sube al repositorio (está en .gitignore).

# --- Frontend (expuestas al navegador vía Vite; solo claves públicas) ---
# URL del proyecto Supabase, ej: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Clave anónima (public) de Supabase. Es segura en el cliente porque RLS
# protege los datos; NO uses aquí la service_role key.
VITE_SUPABASE_ANON_KEY=

# --- Backend (SOLO en Edge Functions / Supabase secrets, nunca en el bundle) ---
# API key de Anthropic (Claude). Se configura como secret en Supabase:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Se documenta aquí como referencia, pero NO se lee desde el frontend.
ANTHROPIC_API_KEY=
